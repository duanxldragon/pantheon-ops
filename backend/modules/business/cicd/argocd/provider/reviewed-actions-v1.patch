+)
+
+type reviewedProtocolServer struct {
+	UnimplementedApplicationServiceServer
+	request     *ApplicationSyncRequest
+	token       string
+	legacyCalls int
+}
+
+func (s *reviewedProtocolServer) ReviewedSync(ctx context.Context, req *ApplicationSyncRequest) (*v1alpha1.Application, error) {
+	s.request = req
+	md, _ := metadata.FromIncomingContext(ctx)
+	s.token = strings.Join(md.Get("token"), "")
+	return &v1alpha1.Application{ObjectMeta: metav1.ObjectMeta{Name: req.GetName(), UID: types.UID(req.Reviewed.GetExpectedUID()), ResourceVersion: req.Reviewed.GetExpectedResourceVersion()}}, nil
+}
+
+func (s *reviewedProtocolServer) Sync(context.Context, *ApplicationSyncRequest) (*v1alpha1.Application, error) {
+	s.legacyCalls++
+	return nil, status.Error(codes.Internal, "native route must not be a fallback")
+}
+
+func protocolClient(t *testing.T, service ApplicationServiceServer) ApplicationServiceClient {
+	t.Helper()
+	listener := bufconn.Listen(1024 * 1024)
+	server := grpc.NewServer()
+	RegisterApplicationServiceServer(server, service)
+	go func() { _ = server.Serve(listener) }()
+	t.Cleanup(server.Stop)
+	t.Cleanup(func() { _ = listener.Close() })
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	defer cancel()
+	conn, err := grpc.DialContext(ctx, "passthrough:///reviewed-protocol", grpc.WithTransportCredentials(insecure.NewCredentials()),
+		grpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { return listener.Dial() }), grpc.WithBlock())
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	return NewApplicationServiceClient(conn)
+}
+
+func TestReviewedProtocolRoundTrip(t *testing.T) {
+	req := &ApplicationSyncRequest{Name: ptr.To("app"), Prune: ptr.To(true), Reviewed: &ReviewedActionPreconditions{
+		ExpectedUID: ptr.To("uid"), ExpectedResourceVersion: ptr.To("7"),
+		ResolvedRevision: ptr.To(strings.Repeat("a", 40)), ActionMarker: ptr.To("action-1"),
+	}}
+	encoded, err := proto.Marshal(req)
+	require.NoError(t, err)
+	var decoded ApplicationSyncRequest
+	require.NoError(t, proto.Unmarshal(encoded, &decoded))
+	require.Equal(t, req, &decoded)
+	server := &reviewedProtocolServer{}
+	client := protocolClient(t, server)
+	_, err = client.ReviewedSync(metadata.AppendToOutgoingContext(t.Context(), "token", "local-test-token"), req)
+	require.NoError(t, err)
+	require.Equal(t, req, server.request)
+	require.Equal(t, "local-test-token", server.token)
+	require.Zero(t, server.legacyCalls)
+}
+
+func TestReviewedGatewayFieldsAndDistinctRoute(t *testing.T) {
+	server := &reviewedProtocolServer{}
+	client := protocolClient(t, server)
+	mux := runtime.NewServeMux()
+	require.NoError(t, RegisterApplicationServiceHandlerClient(t.Context(), mux, client))
+	body := `{"name":"app","prune":true,"reviewed":{"expectedUID":"uid","expectedResourceVersion":"7","resolvedRevision":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","actionMarker":"action-1"}}`
+	req := httptest.NewRequest(http.MethodPost, "/api/v1/applications/app/reviewed-actions/sync", strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Grpc-Metadata-Token", "local-test-token")
+	response := httptest.NewRecorder()
+	mux.ServeHTTP(response, req)
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	require.Equal(t, "app", server.request.GetName())
+	require.Equal(t, "uid", server.request.Reviewed.GetExpectedUID())
+	require.Equal(t, "7", server.request.Reviewed.GetExpectedResourceVersion())
+	require.Equal(t, strings.Repeat("a", 40), server.request.Reviewed.GetResolvedRevision())
+	require.Equal(t, "action-1", server.request.Reviewed.GetActionMarker())
+	require.True(t, server.request.GetPrune())
+	require.Equal(t, "local-test-token", server.token)
+	require.Zero(t, server.legacyCalls)
+	var application map[string]any
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &application))
+	require.Equal(t, "uid", application["metadata"].(map[string]any)["uid"])
+}
+
+func TestReviewedUnavailableNeverUsesLegacy(t *testing.T) {
+	// The generated unimplemented service models a peer without reviewed handlers.
+	// Official stock descriptors/routes are also checked against the pinned source manifest.
+	client := protocolClient(t, &UnimplementedApplicationServiceServer{})
+	_, err := client.ReviewedSync(t.Context(), &ApplicationSyncRequest{Name: ptr.To("app")})
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+	_, err = client.ReviewedRollback(t.Context(), &ApplicationRollbackRequest{Name: ptr.To("app"), Id: ptr.To(int64(0))})
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+	_, err = client.ReviewedActionsCapabilities(t.Context(), &ApplicationSyncWindowsQuery{Name: ptr.To("app")})
+	require.Equal(t, codes.Unimplemented, status.Code(err))
+}
+
+type reviewedConflictProtocolServer struct {
+	UnimplementedApplicationServiceServer
+}
+
+func (*reviewedConflictProtocolServer) ReviewedSync(context.Context, *ApplicationSyncRequest) (*v1alpha1.Application, error) {
+	return nil, status.Error(codes.Aborted, "review again")
+}
+
+func TestReviewedGatewayConflictIs409(t *testing.T) {
+	client := protocolClient(t, &reviewedConflictProtocolServer{})
+	mux := runtime.NewServeMux()
+	require.NoError(t, RegisterApplicationServiceHandlerClient(t.Context(), mux, client))
+	response := httptest.NewRecorder()
+	mux.ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/api/v1/applications/app/reviewed-actions/sync", strings.NewReader(`{"name":"app"}`)))
+	require.Equal(t, http.StatusConflict, response.Code)
+}
