+func TestReviewedCapabilitiesAndUnsupportedSources(t *testing.T) {
+	a := reviewedTestApp()
+	s := newTestAppServer(t, a)
+	capability, err := s.ReviewedActionsCapabilities(reviewedTestContext(t), &application.ApplicationSyncWindowsQuery{Name: &a.Name})
+	require.NoError(t, err)
+	require.Equal(t, reviewedActionsProtocol, capability.GetProtocol())
+	require.Equal(t, "single-git-sha1", capability.GetRevisionScope())
+	require.True(t, capability.GetConditionalUpdate())
+	require.True(t, capability.GetNativePolicy())
+	require.True(t, capability.GetCorrelatedRollback())
+	require.Equal(t, reviewedActionMarkerName, capability.GetMarkerName())
+	require.Zero(t, applicationActions(s, "update"))
+	for _, sourceType := range []string{"multi", "chart"} {
+		t.Run(sourceType, func(t *testing.T) {
+			a := reviewedTestApp()
+			if sourceType == "multi" {
+				a.Spec.Sources = []v1alpha1.ApplicationSource{*a.Spec.Source, *a.Spec.Source}
+			} else {
+				a.Spec.Source.Chart = "chart"
+			}
+			s := newTestAppServer(t, a)
+			_, err := s.ReviewedSync(reviewedTestContext(t), reviewedTestRequest(a))
+			require.Error(t, err)
+			require.Zero(t, applicationActions(s, "update"))
+		})
+	}
+}
