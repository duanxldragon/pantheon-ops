+func TestReviewedSingleUpdateCancellationAndFastConsume(t *testing.T) {
+	a := reviewedTestApp()
+	p := reviewedTestPreconditions(a)
+	op := &v1alpha1.Operation{Sync: &v1alpha1.SyncOperation{Source: a.Spec.Source.DeepCopy(), Revision: reviewedTestRevision, Prune: true}, Info: reviewedActionInfo(p)}
+	t.Run("already-canceled", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel()
+		client := &reviewedUpdateClient{}
+		_, err := setReviewedAppOperation(ctx, client, a, op, p)
+		require.Equal(t, codes.Canceled, status.Code(err))
+		require.Zero(t, client.calls)
+	})
+	t.Run("cancel-during-update", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		defer cancel()
+		client := &reviewedUpdateClient{update: func(actual context.Context, _ *v1alpha1.Application) (*v1alpha1.Application, error) {
+			require.Equal(t, ctx, actual)
+			cancel()
+			return nil, actual.Err()
+		}}
+		_, err := setReviewedAppOperation(ctx, client, a, op, p)
+		require.Equal(t, codes.Canceled, status.Code(err))
+		require.Equal(t, 1, client.calls)
+	})
+	t.Run("lost-reply-no-retry", func(t *testing.T) {
+		client := &reviewedUpdateClient{update: func(_ context.Context, _ *v1alpha1.Application) (*v1alpha1.Application, error) {
+			return nil, errors.New("write may have committed; reply lost")
+		}}
+		result, err := setReviewedAppOperation(t.Context(), client, a, op, p)
+		require.Error(t, err)
+		require.Nil(t, result)
+		require.Equal(t, 1, client.calls)
+	})
+	t.Run("fast-consume-keeps-write-response", func(t *testing.T) {
+		var current *v1alpha1.Application
+		client := &reviewedUpdateClient{update: func(_ context.Context, written *v1alpha1.Application) (*v1alpha1.Application, error) {
+			written.ResourceVersion = "8"
+			receipt := written.DeepCopy()
+			current = written.DeepCopy()
+			current.Operation = nil
+			current.Status.OperationState = &v1alpha1.OperationState{Operation: *written.Operation.DeepCopy(), Phase: synccommon.OperationSucceeded}
+			current.ResourceVersion = "9"
+			return receipt, nil
+		}}
+		result, err := setReviewedAppOperation(t.Context(), client, a, op, p)
+		require.NoError(t, err)
+		require.Equal(t, 1, client.calls)
+		require.Equal(t, "8", result.ResourceVersion)
+		require.Equal(t, op, result.Operation)
+		require.Nil(t, result.Status.OperationState)
+		require.Nil(t, current.Operation)
+		require.Equal(t, op.Info, current.Status.OperationState.Operation.Info)
+		require.Nil(t, a.Operation, "caller snapshot must remain immutable")
+	})
+	t.Run("invalid-operation-before-update", func(t *testing.T) {
+		client := &reviewedUpdateClient{}
+		_, err := setReviewedAppOperation(t.Context(), client, a, &v1alpha1.Operation{}, p)
+		require.Equal(t, codes.InvalidArgument, status.Code(err))
+		require.Zero(t, client.calls)
+	})
+}
