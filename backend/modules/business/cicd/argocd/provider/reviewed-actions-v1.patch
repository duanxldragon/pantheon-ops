+	appclient "github.com/argoproj/argo-cd/v3/pkg/client/clientset/versioned/typed/application/v1alpha1"
+	"github.com/argoproj/argo-cd/v3/util/rbac"
+	"github.com/argoproj/argo-cd/v3/util/session"
+)
+
+const reviewedActionsProtocol = "pantheon-reviewed-actions/v1"
+const reviewedActionMarkerName = "pantheon-action-id"
+
+var reviewedRevisionPattern = regexp.MustCompile(`^[0-9a-f]{40}$`)
+var reviewedMarkerPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{1,128}$`)
+
+// ReviewedActionsCapabilities uses the same authenticated, scoped application read as Sync.
+// Capability discovery does not grant sync permission or predict policy at submission time.
+func (s *Server) ReviewedActionsCapabilities(ctx context.Context, req *application.ApplicationSyncWindowsQuery) (*application.ReviewedActionsCapabilitiesResponse, error) {
+	if err := validateReviewedContext(ctx); err != nil {
+		return nil, err
+	}
+	if req == nil || req.GetName() == "" {
+		return nil, status.Error(codes.InvalidArgument, "application name is required")
+	}
+	if _, _, err := s.getApplicationEnforceRBACClient(ctx, rbac.ActionGet, req.GetProject(), req.GetAppNamespace(), req.GetName(), ""); err != nil {
+		return nil, err
+	}
+	return &application.ReviewedActionsCapabilitiesResponse{
+		Protocol: ptr.To(reviewedActionsProtocol), RevisionScope: ptr.To("single-git-sha1"),
+		MarkerName: ptr.To(reviewedActionMarkerName), ConditionalUpdate: ptr.To(true),
+		NativePolicy: ptr.To(true), CorrelatedRollback: ptr.To(true),
+	}, nil
+}
+
+func (s *Server) ReviewedSync(ctx context.Context, req *application.ApplicationSyncRequest) (*v1alpha1.Application, error) {
+	if err := validateReviewedContext(ctx); err != nil {
+		return nil, err
+	}
+	if req == nil || req.GetName() == "" {
+		return nil, status.Error(codes.InvalidArgument, "application name is required")
+	}
+	if err := validateReviewedPreconditions(req.Reviewed); err != nil {
+		return nil, err
+	}
+	// V1 deliberately has one immutable Git revision and one correlation marker.
+	if req.Manifests != nil || len(req.Revisions) != 0 || len(req.SourcePositions) != 0 || len(req.Infos) != 0 {
+		return nil, status.Error(codes.InvalidArgument, "reviewed sync requires a single Git source and no supplied infos or manifests")
+	}
+	return s.sync(ctx, req, req.Reviewed)
+}
+
+func (s *Server) ReviewedRollback(ctx context.Context, req *application.ApplicationRollbackRequest) (*v1alpha1.Application, error) {
+	if err := validateReviewedContext(ctx); err != nil {
+		return nil, err
+	}
+	if req == nil || req.GetName() == "" || req.Id == nil || req.GetId() < 0 {
+		return nil, status.Error(codes.InvalidArgument, "application name and history ID are required")
+	}
+	if err := validateReviewedPreconditions(req.Reviewed); err != nil {
+		return nil, err
+	}
+	// Native rollback checks sync RBAC and auto-sync; it does not check sync windows.
+	return s.rollback(ctx, req, req.Reviewed)
+}
+
+func validateReviewedContext(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return status.FromContextError(err).Err()
+	}
+	// Reuse the principal supplied by Argo's authentication interceptor. Reviewed
+	// actions cannot be authorized by an anonymous default role or DisableAuth.
+	if session.Username(ctx) == "" {
+		return status.Error(codes.Unauthenticated, "authenticated reviewed action principal is required")
+	}
+	return nil
+}
+
+func validateReviewedPreconditions(p *application.ReviewedActionPreconditions) error {
+	if p == nil || !boundedReviewedIdentity(p.GetExpectedUID()) || !boundedReviewedIdentity(p.GetExpectedResourceVersion()) ||
+		!reviewedRevisionPattern.MatchString(p.GetResolvedRevision()) || !reviewedMarkerPattern.MatchString(p.GetActionMarker()) {
+		return status.Error(codes.InvalidArgument, "reviewed action requires bounded UID/resourceVersion, resolved Git SHA and one action marker")
+	}
+	return nil
+}
+
+func boundedReviewedIdentity(value string) bool {
+	if len(value) == 0 || len(value) > 128 {
+		return false
+	}
+	for _, ch := range value {
+		if ch <= ' ' || ch > '~' {
+			return false
+		}
+	}
+	return true
+}
+
+func validateReviewedApplication(a *v1alpha1.Application, p *application.ReviewedActionPreconditions) error {
+	if a == nil || string(a.UID) != p.GetExpectedUID() || a.ResourceVersion != p.GetExpectedResourceVersion() {
+		return status.Error(codes.Aborted, "reviewed application identity or version changed; review again")
+	}
+	if a.DeletionTimestamp != nil {
+		return status.Error(codes.FailedPrecondition, "application is deleting")
+	}
+	if a.Operation != nil || (a.Status.OperationState != nil && !a.Status.OperationState.Phase.Completed()) {
+		return status.Error(codes.FailedPrecondition, "another operation is in progress")
+	}
+	if a.Spec.HasMultipleSources() {
+		return status.Error(codes.FailedPrecondition, "reviewed actions v1 requires a single Git source")
+	}
+	return nil
+}
+
+func reviewedActionInfo(p *application.ReviewedActionPreconditions) []*v1alpha1.Info {
+	return []*v1alpha1.Info{{Name: reviewedActionMarkerName, Value: p.GetActionMarker()}}
+}
+
+// setReviewedAppOperation commits the SAME application used for policy and native operation
+// construction. The Kubernetes API enforces UID and resourceVersion on this single Update.
+// There is no name-only reread, conflict retry, or background context on this path.
+func setReviewedAppOperation(ctx context.Context, appIf appclient.ApplicationInterface, a *v1alpha1.Application, op *v1alpha1.Operation, p *application.ReviewedActionPreconditions) (*v1alpha1.Application, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, status.FromContextError(err).Err()
+	}
+	if err := validateReviewedPreconditions(p); err != nil {
+		return nil, err
+	}
+	if err := validateReviewedApplication(a, p); err != nil {
+		return nil, err
+	}
+	if op == nil || op.Sync == nil || op.Sync.Source == nil || op.Sync.Source.IsZero() ||
+		op.Sync.Source.IsHelm() || len(op.Sync.Sources) != 0 || len(op.Sync.Revisions) != 0 || len(op.Sync.Manifests) != 0 ||
+		len(op.Info) != 1 || op.Info[0] == nil || op.Info[0].Name != reviewedActionMarkerName || op.Info[0].Value != p.GetActionMarker() {
+		return nil, status.Error(codes.InvalidArgument, "invalid reviewed single-source Git operation or action marker")
+	}
+	if op.Sync.Revision != p.GetResolvedRevision() {
+		return nil, status.Error(codes.Aborted, "resolved revision differs from review; review again")
+	}
+	updated := a.DeepCopy()
+	updated.Operation = op.DeepCopy()
+	updated.Status.OperationState = nil
+	result, err := appIf.Update(ctx, updated, metav1.UpdateOptions{})
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, status.FromContextError(ctx.Err()).Err()
+		}
+		if apierrors.IsConflict(err) || apierrors.IsNotFound(err) {
+			return nil, status.Error(codes.Aborted, "reviewed application changed at acceptance; review again")
+		}
+		return nil, err
+	}
+	// Return the API server's write response, including the correlated operation, even if
+	// a controller consumes it immediately after acceptance. Never manufacture terminal state.
+	return result, nil
+}
