 15s\n  evaluation_interval: 15s\nscrape_configs:\n  - job_name: ''prometheus''\n    static_configs:\n      - targets: [''localhost:9090'']\nEOF\nid prometheus \u003e/dev/null 2\u003e\u00261 || useradd --system --home-dir \"$INSTALL_ROOT\" --shell /sbin/nologin prometheus\nchown -R prometheus:prometheus \"$INSTALL_ROOT\" \"$DATA_ROOT\"\ncat \u003e /etc/systemd/system/prometheus.service \u003c\u003cEOF\n[Unit]\nDescription=Prometheus\nAfter=network.target\n[Service]\nType=simple\nUser=prometheus\nGroup=prometheus\nExecStart=$INSTALL_ROOT/prometheus --config.file=$INSTALL_ROOT/prometheus.yml --storage.tsdb.path=$DATA_ROOT --web.listen-address=:9090\nRestart=always\n[Install]\nWantedBy=multi-user.target\nEOF\nsystemctl daemon-reload\nsystemctl enable prometheus \u003e/dev/null 2\u003e\u00261\nsystemctl start prometheus\nrm -f \"$ARCHIVE\"\nrm -rf /tmp/prom-extract\nsleep 3\nif curl -fsS http://127.0.0.1:9090/-/ready \u003e/dev/null 2\u003e\u00261; then echo \"PROMETHEUS_READY (offline)\"; else echo \"PROMETHEUS_NOT_READY\"; systemctl status prometheus --no-pager -l | tail -8; exit 1; fi"}}]}' AS JSON),NULL,'',0,0,'',1800,'draft','uni-validation uni-20260830223554','',false,NULL,NULL,'',NULL,NULL,NULL,'2026-08-30 22:42:09.296','2026-08-30 22:42:09.296','1','1',NULL)

