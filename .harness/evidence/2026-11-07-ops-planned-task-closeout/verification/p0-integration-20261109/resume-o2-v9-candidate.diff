+func driverSourcePath(t *testing.T) string {
+	t.Helper()
+	// Named-file tests retain this absolute source location in their call frames.
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("named-file source location unavailable")
+	}
+	return file
+}
 
