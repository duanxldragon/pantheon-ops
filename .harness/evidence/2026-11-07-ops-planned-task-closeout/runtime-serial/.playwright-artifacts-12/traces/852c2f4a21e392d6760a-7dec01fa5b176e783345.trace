03, 213, 225;\n  --pantheon-primary-4: 148, 163, 184;\n  --pantheon-primary-5: 100, 116, 139;\n  --pantheon-primary-6: 51, 65, 85;\n  --pantheon-primary-7: 30, 41, 59;\n  --pantheon-primary-8: 15, 23, 42;\n  --pantheon-primary-9: 8, 15, 29;\n  --pantheon-primary-10: 2, 6, 23;\n}\n\n/* ===========================================================================\n   P3-1 暗色模式 —— 语义角色重定义（非机械反色）\n   仅覆盖中性 surface/text/shadow/软背景等 token；品牌色按主题在下方提亮。\n   Arco 组件通过 body[arco-theme='dark'] 联动，二者由 colorMode.ts 同步设置。\n   =========================================================================== */\n:root[data-color-mode='dark'] {\n  color: #e5e8ee;\n  background: #0d1118;\n  --app-bg: #0f141c;\n  --app-shell-overlay: #171e28;\n  --panel-bg: #171e28;\n  --panel-bg-solid: #171e28;\n  --panel-muted: #1b2530;\n  --panel-border: rgba(255, 255, 255, 0.1);\n  --panel-border-strong: rgba(255, 255, 255, 0.18);\n  --panel-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);\n  --panel-shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 18px rgba(0, 0, 0, 0.32);\n  --panel-shadow-strong: 0 18px 42px rgba(0, 0, 0, 0.58);\n  --text-primary: #e5e8ee;\n  --text-secondary: #a9b2c0;\n  --text-tertiary: #727d8f;\n  --control-bg: #10161e;\n  --surface-lift: #26313f;\n  /* 软背景在暗色下略提高透明度，保证语义色可辨 */\n  --color-success-bg: rgba(0, 180, 42, 0.2);\n  --color-warning-bg: rgba(255, 125, 0, 0.2);\n  --color-error-bg: rgba(245, 63, 63, 0.2);\n  --color-info-bg: rgba(52, 145, 250, 0.2);\n  /* 侧栏在暗色下与内容区统一为深表面，弱化边界差 */\n  --shell-sider-bg: #12161f;\n  --shell-sider-elevated: #1a212c;\n  --shell-sider-border: rgba(255, 255, 255, 0.08);\n  /* 容器分类 - 暗色模式 */\n  --container-interactive-bg: var(--panel-bg-solid);\n  --container-interactive-border: var(--panel-border);\n  --container-interactive-hover-bg: rgba(91, 136, 255, 0.1);\n  --container-interactive-focus-border: var(--brand-primary);\n  --container-display-bg: var(--panel-muted);\n  --container-display-border: rgba(255, 255, 255, 0.08);\n  --container-display-separator: rgba(255, 255, 255, 0.04);\n  --container-display-elevated: var(--panel-bg-solid);\n}\n\n/* 品牌色在暗色下提亮、略降饱和、保持色相 */\n:root[data-color-mode='dark'][data-pantheon-theme='indigo'],\n:root[data-color-mode='dark']:not([data-pantheon-theme]) {\n  --brand-primary: #5b88ff;\n  --brand-primary-soft: rgba(91, 136, 255, 0.22);\n  --brand-primary-muted: rgba(91, 136, 255, 0.14);\n}\n\n:root[data-color-mode='dark'][data-pantheon-theme='emerald'] {\n  --brand-primary: #1fc78f;\n  --brand-primary-soft: rgba(31, 199, 143, 0.22);\n  --brand-primary-muted: rgba(31, 199, 143, 0.14);\n}\n\n:root[data-color-mode='dark'][data-pantheon-theme='violet'] {\n  --brand-primary: #9a6cf0;\n  --brand-primary-soft: rgba(154, 108, 240, 0.22);\n  --brand-primary-muted: rgba(154, 108, 240, 0.14);\n}\n\n:root[data-color-mode='dark'][data-pantheon-theme='slate'] {\n  --brand-primary: #7c8ba3;\n  --brand-primary-soft: rgba(124, 139, 163, 0.24);\n  --brand-primary-muted: rgba(124, 139, 163, 0.16);\n}\n\n:root[data-pantheon-density='compact'] {\n  --shell-page-gap: 12px;\n  --shell-page-header-gap: 10px;\n  --shell-panel-body-padding: 14px;\n  --shell-panel-head-min-height: 52px;\n  --shell-page-split-gap: 12px;\n  --shell-page-main-gap: 12px;\n  --shell-page-side-gap: 10px;\n  --shell-table-cell-padding-y: 8px;\n  --shell-table-cell-padding-x: 12px;\n  --shell-table-card-padding: 10px 12px 2px;\n  --shell-table-pagination-padding: 8px 12px 0;\n  --shell-table-action-min-height: 28px;\n  --shell-control-min-height: 30px;\n  --shell-filter-body-padding: 12px 14px 4px;\n  --shell-filter-control-min-height: 32px;\n  --shell-filter-form-item-margin-bottom: 10px;\n  --shell-filter-label-padding-bottom: 2px;\n  --shell-list-actions-gap: 6px 10px;\n  --shell-action-bar-gap: 6px 10px;\n  --shell-action-bar-min-height: 28px;\n  --shell-table-head-gap: 6px 10px;\n}\n\nhtml,\nbody,\n#root {\n  width: 100%;\n  min-height: 100dvh;\n  margin: 0;\n}\n\nbody {\n  font-family:\n    system-ui,\n    -apple-system,\n    BlinkMacSystemFont,\n    'Segoe UI',\n    'Microsoft YaHei',\n    sans-serif;\n  background: var(--app-bg);\n  color: var(--text-primary);\n  font-feature-settings: 'tnum' 1;\n  /* Arco 组件的 --primary-* 定义在 body 上，:root 的主题梯度会被覆盖；\n     这里用 :root 侧透传的 --pantheon-primary-* 把主题色同步给 Arco。 */\n  --primary-1: var(--pantheon-primary-1);\n  --primary-2: var(--pantheon-primary-2);\n  --primary-3: var(--pantheon-primary-3);\n  --primary-4: var(--pantheon-primary-4);\n  --primary-5: var(--pantheon-primary-5);\n  --primary-6: var(--pantheon-primary-6);\n  --primary-7: var(--pantheon-primary-7);\n  --primary-8: var(--pantheon-primary-8);\n  --primary-9: var(--pantheon-primary-9);\n  --primary-10: var(--pantheon-primary-10);\n}\n\n* {\n  box-sizing: border-box;\n}\n\na {\n  color: inherit;\n}\n\n:where(\n  a,\n  button,\n  [role='button'],\n  [tabindex]:not([tabindex='-1']),\n  input,\n  textarea,\n  select,\n  .arco-btn,\n  .arco-input-inner-wrapper,\n  .arco-input,\n  .arco-select-view,\n  .arco-tree-select-view,\n  .arco-picker,\n  .arco-checkbox,\n  .arco-radio,\n  .arco-switch\n):focus-visible {\n  outline: 2px solid color-mix(in srgb, var(--brand-primary) 58%, #ffffff);\n  outline-offset: 2px;\n}\n\n:where(\n  .arco-input-inner-wrapper,\n  .arco-input-password,\n  .arco-input-number,\n  input.arco-input,\n  .arco-select-view,\n  .arco-tree-select-view,\n  .arco-picker,\n  .arco-textarea-wrapper,\n  textarea.arco-textarea,\n  .arco-input-tag\n):focus-visible {\n  outline: 0;\n}\n\n/* ===========================================================================\n   交互容器样式 - 使用 --container-interactive-* token\n   应用于需要用户操作的元素：输入框、选择器、可点击卡片\n   =========================================================================== */\n.arco-input-inner-wrapper,\n.arco-input-password,\n.arco-input-number,\ninput.arco-input,\n.arco-select-view,\n.arco-tree-select-view,\n.arco-picker,\n.arco-textarea-wrapper {\n  background-color: var(--container-interactive-bg);\n  border-color: var(--container-interactive-border);\n}\n\n.arco-input-inner-wrapper:hover,\n.arco-select-view:hover,\n.arco-tree-select-view:hover,\n.arco-picker:hover {\n  background-color: var(--container-interactive-hover-bg);\n}\n\n.arco-input-inner-wrapper:focus-within,\n.arco-input-inner-wrapper.arco-input-focus,\n.arco-select-view.arco-select-view-focus,\n.arco-tree-select-view.arco-tree-select-view-focus,\n.arco-picker.arco-picker-focused {\n  border-color: var(--container-interactive-focus-border);\n  background-color: var(--container-interactive-bg);\n}\n\n/* ===========================================================================\n   展示容器样式 - 使用 --container-display-* token\n   应用于只读展示的元素：卡片、描述列表、统计面板、信息展示区\n   =========================================================================== */\n.arco-card {\n  background-color: var(--container-display-elevated);\n  border-color: var(--container-display-border);\n}\n\n.arco-descriptions {\n  background-color: var(--container-display-bg);\n  border-radius: var(--radius-md);\n}\n\n.arco-table {\n  background-color: var(--container-display-elevated);\n}\n\n.arco-table-th,\n.arco-table-td {\n  border-color: var(--container-display-border);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :root[data-pantheon-theme][data-pantheon-theme] *,\n  :root[data-pantheon-theme][data-pantheon-theme] *::before,\n  :root[data-pantheon-theme][data-pantheon-theme] *::after {\n    animation-duration: 0.01ms;\n    animation-iteration-count: 1;\n    scroll-behavior: auto;\n    transition-duration: 0.01ms;\n  }\n}\n\n.page-container {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  gap: var(--shell-page-gap);\n}\n\n.page-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--shell-page-header-gap);\n  padding: 0 0 2px;\n}\n\n.page-header__meta {\n  min-width: 0;\n  display: grid;\n  gap: 4px;\n}\n\n.page-header__extra {\n  flex-shrink: 0;\n}\n\n.page-actions {\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.setting-page__form-stack {\n  width: 100%;\n}\n\n.setting-page__field-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px 16px;\n}\n\n.menu-list-form__grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px 16px;\n}\n\n.setting-page__field {\n  margin-bottom: 0;\n}\n\n.menu-list-form__grid .arco-form-item {\n  margin-bottom: 0;\n}\n\n.menu-list-form__grid .arco-form-item-content {\n  min-width: 0;\n}\n\n.menu-list-form__grid .arco-form-item-control,\n.menu-list-form__grid .arco-form-item-control-children,\n.menu-list-form__grid .arco-tree-select,\n.menu-list-form__grid .arco-select,\n.menu-list-form__grid .arco-auto-complete,\n.menu-list-form__grid .arco-input-number {\n  width: 100%;\n  min-width: 0;\n}\n\n.menu-list-form__grid .arco-form-item-label-col {\n  padding-bottom: 2px;\n}\n\n.menu-list-form__field--full {\n  grid-column: 1 / -1;\n}\n\n.setting-page__field--full {\n  grid-column: 1 / -1;\n}\n\n.setting-page__field .arco-form-item-extra {\n  margin-top: 4px;\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n.setting-page__field .arco-form-item-label-col {\n  padding-bottom: 2px;\n}\n\n.setting-page__field .arco-form-item-content {\n  min-width: 0;\n}\n\n.setting-page__save-hint {\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n.setting-page__actions {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px 12px;\n  flex-wrap: wrap;\n}\n\n.setting-page__meta-actions {\n  gap: 8px;\n  margin-right: auto;\n}\n\n.setting-page__actions .submit-bar {\n  width: auto;\n  padding-top: 0;\n}\n\n.setting-page__audit-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 8px 12px;\n  flex-wrap: wrap;\n  margin-bottom: 10px;\n}\n\n.setting-page__governance-stack {\n  display: grid;\n  gap: 12px;\n}\n\n/* 4 metric cards with descriptions: a fixed 2x2 grid avoids the 3+1 auto-fit hole. */\n.setting-page__governance-bar .governance-summary-bar__metrics {\n  grid-template-columns: repeat(2, minmax(140px, 1fr));\n}\n\n.setting-page__group-nav-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 8px;\n}\n\n.setting-page__group-nav-item {\n  display: grid;\n  gap: 4px;\n  width: 100%;\n  min-height: 82px;\n  padding: 10px 12px;\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-md);\n  background: var(--panel-bg-solid);\n  text-align: left;\n  transition:\n    border-color var(--motion-duration-base) ease,\n    background-color var(--motion-duration-base) ease;\n  cursor: pointer;\n}\n\n.setting-page__group-nav-item:hover,\n.setting-page__group-nav-item:focus-visible {\n  border-color: color-mix(in srgb, var(--brand-primary) 26%, var(--panel-border));\n  background: color-mix(in srgb, var(--brand-primary) 3%, var(--surface-lift));\n  outline: none;\n}\n\n.setting-page__group-nav-item--active {\n  border-color: color-mix(in srgb, var(--brand-primary) 34%, var(--panel-border));\n  background: color-mix(in srgb, var(--brand-primary) 5%, var(--surface-lift));\n}\n\n.setting-page__group-nav-title-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.setting-page__group-nav-title {\n  color: var(--text-primary);\n  font-size: 13px;\n  font-weight: 600;\n  line-height: 1.35;\n}\n\n.setting-page__group-nav-desc,\n.setting-page__group-nav-meta {\n  color: var(--text-secondary);\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.setting-page__group-nav-desc {\n  display: -webkit-box;\n  min-height: 34px;\n  overflow: hidden;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n}\n\n.setting-page__runtime-strip {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 16px;\n  padding: 10px 12px;\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-md);\n  background: var(--panel-bg-solid);\n  font-size: 12px;\n}\n\n.dict-page__governance-bar,\n.setting-page__governance-bar {\n  width: 100%;\n}\n\n.dict-page__tabs .arco-tabs-header {\n  margin-bottom: 10px;\n}\n\n.dict-page__tabs .arco-tabs-content {\n  min-width: 0;\n}\n\n.setting-page__runtime-strip .arco-typography {\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.setting-overview-page__layout {\n  width: 100%;\n}\n\n.setting-overview-page__anchor-strip {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  gap: 0;\n  padding: 0 8px;\n  border-bottom: 1px solid var(--panel-border);\n  margin-bottom: -1px;\n}\n\n.setting-overview-page__anchor-item {\n  position: relative;\n  display: grid;\n  flex: 1 1 168px;\n  gap: 3px;\n  min-width: 0;\n  min-height: 72px;\n  margin-bottom: -1px;\n  padding: 10px 14px 11px;\n  border: 1px solid transparent;\n  border-bottom: none;\n  border-radius: 8px 8px 0 0;\n  background: transparent;\n  text-align: left;\n  cursor: pointer;\n  transition:\n    border-color var(--motion-duration-base) ease,\n    background-color var(--motion-duration-base) ease,\n    color var(--motion-duration-base) ease;\n}\n\n.setting-overview-page__anchor-item:hover,\n.setting-overview-page__anchor-item:focus-visible {\n  background: color-mix(in srgb, var(--brand-primary) 4%, var(--surface-lift));\n  outline: none;\n}\n\n.setting-overview-page__anchor-item:focus-visible {\n  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand-primary) 28%, transparent);\n}\n\n.setting-overview-page__anchor-item--active {\n  z-index: var(--z-base);\n  border-color: color-mix(in srgb, var(--brand-primary) 22%, var(--panel-border));\n  background: var(--panel-bg-solid);\n  box-shadow: inset 0 1px 0 color-mix(in srgb, var(--brand-primary) 10%, transparent);\n}\n\n.setting-overview-page__anchor-item--active::after {\n  content: '';\n  position: absolute;\n  right: 0;\n  bottom: -1px;\n  left: 0;\n  height: 1px;\n  background: var(--panel-bg-solid);\n}\n\n.setting-overview-page__anchor-title-row {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 8px;\n  min-width: 0;\n}\n\n.setting-overview-page__anchor-title {\n  color: var(--text-primary);\n  font-size: 13px;\n  font-weight: 600;\n  line-height: 1.35;\n}\n\n.setting-overview-page__anchor-desc,\n.setting-overview-page__anchor-meta {\n  color: var(--text-secondary);\n  font-size: 11px;\n  line-height: 1.4;\n}\n\n.setting-overview-page__anchor-desc {\n  display: -webkit-box;\n  min-height: 16px;\n  overflow: hidden;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 1;\n}\n\n.setting-overview-page__anchor-meta {\n  font-weight: 500;\n}\n\n.setting-overview-page__anchor-item .arco-tag {\n  margin-left: auto;\n}\n\n.setting-overview-page__anchor-item--active .setting-overview-page__anchor-title {\n  color: color-mix(in srgb, var(--brand-primary) 70%, var(--text-primary));\n}\n\n.setting-overview-page__workspace {\n  position: relative;\n}\n\n.setting-overview-page__workspace-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.setting-group-workspace {\n  scroll-margin-top: 88px;\n}\n\n.setting-overview-page__rail {\n  gap: 12px;\n}\n\n.setting-overview-page__risk-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.setting-overview-page__risk-item {\n  display: grid;\n  gap: 6px;\n  padding: 10px 12px;\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-xs);\n  background: var(--panel-bg-solid);\n}\n\n.setting-overview-page__risk-item--warning {\n  border-color: color-mix(in srgb, var(--color-warning-bg) 58%, var(--panel-border));\n  background: color-mix(in srgb, var(--color-warning-bg) 18%, var(--surface-lift));\n}\n\n.setting-overview-page__risk-item--critical {\n  border-color: color-mix(in srgb, var(--color-error-bg) 62%, var(--panel-border));\n  background: color-mix(in srgb, var(--color-error-bg) 14%, var(--surface-lift));\n}\n\n.setting-overview-page__risk-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.setting-overview-page__risk-header .arco-btn {\n  padding-inline: 0;\n}\n\n.setting-overview-page__risk-title {\n  color: var(--text-primary);\n  font-weight: 600;\n  line-height: 1.5;\n}\n\n.setting-overview-page__risk-desc {\n  display: block;\n  line-height: 1.6;\n}\n\n.submit-bar {\n  display: flex;\n  align-items: flex-start;\n  justify-content: flex-end;\n  gap: 12px;\n  width: 100%;\n  padding-top: 4px;\n}\n\n.operational-visual-fixture {\n  min-height: 100vh;\n  padding: 24px;\n  background: var(--page-bg);\n}\n\n.operational-visual-fixture__grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.operational-visual-fixture__grid > .operational-primitive,\n.operational-visual-fixture__grid > .arco-card {\n  min-width: 0;\n}\n\n.operational-visual-fixture__registry .arco-card-body {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.operational-visual-fixture__registry [data-dashboard-slot] {\n  padding: 6px 8px;\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n}\n\n@media (max-width: 768px) {\n  .operational-visual-fixture {\n    padding: 16px;\n  }\n\n  .operational-visual-fixture__grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.submit-bar__state {\n  flex: 1;\n  min-width: 0;\n  display: grid;\n  gap: 6px;\n}\n\n.submit-bar__status {\n  color: var(--text-secondary);\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n.submit-bar__error {\n  max-width: 720px;\n  padding: 8px 10px;\n  border: 1px solid color-mix(in srgb, var(--color-error) 18%, var(--panel-border));\n  border-radius: var(--radius-md);\n  background: color-mix(in srgb, var(--color-error-bg) 56%, var(--surface-lift));\n  color: var(--color-error);\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n.submit-bar__actions {\n  flex: 0 0 auto;\n  justify-content: flex-end;\n}\n\n.submit-bar__actions .arco-space-item {\n  min-width: 0;\n}\n\n.submit-bar[data-sticky='true'] {\n  position: sticky;\n  z-index: 10;\n  bottom: max(0px, env(safe-area-inset-bottom));\n  align-items: center;\n  min-height: 58px;\n  margin-top: 16px;\n  padding: 10px 0 max(10px, env(safe-area-inset-bottom));\n  border-top: 1px solid var(--panel-border);\n  background: color-mix(in srgb, var(--panel-bg-solid) 96%, transparent);\n  backdrop-filter: blur(8px);\n}\n\n.submit-bar[data-status='dirty'] .submit-bar__status {\n  color: var(--brand-primary);\n}\n\n.submit-bar[data-status='success'] .submit-bar__status {\n  color: var(--color-success);\n}\n\n.submit-bar[data-status='error'] .submit-bar__status,\n.submit-bar[data-status='conflict'] .submit-bar__status {\n  color: var(--color-error);\n}\n\n@media (max-width: 768px) {\n  .submit-bar {\n    align-items: stretch;\n  }\n\n  .submit-bar[data-sticky='true'] {\n    flex-direction: column;\n    align-items: stretch;\n    padding-inline: 0;\n  }\n\n  .submit-bar__actions {\n    width: 100%;\n  }\n\n  .submit-bar__actions.arco-space-horizontal {\n    justify-content: flex-end;\n  }\n\n  .submit-bar__actions .arco-btn-primary {\n    min-width: min(172px, 48vw);\n  }\n\n  .submit-bar__overflow {\n    width: 36px;\n    padding-inline: 0;\n  }\n}\n\n.page-empty,\n.page-loading {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.page-empty {\n  min-height: 220px;\n  padding: 16px 0;\n}\n\n.page-loading {\n  min-height: 240px;\n}\n\n.page-panel {\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-md);\n  background: var(--panel-bg-solid);\n  box-shadow: var(--panel-shadow-soft);\n}\n\n.side-rail-panel.side-rail-panel {\n  position: relative;\n  overflow: hidden;\n  border-color: var(--panel-border);\n  background: var(--panel-bg-solid);\n}\n\n.side-rail-panel::before {\n  content: '';\n  position: absolute;\n  inset: 0 0 auto;\n  height: 2px;\n  background: var(--brand-primary);\n  opacity: 0.54;\n}\n\n.page-panel .arco-card-head {\n  min-height: var(--shell-panel-head-min-height);\n  padding-top: 6px;\n  padding-bottom: 6px;\n}\n\n.page-panel .arco-card-body {\n  padding: var(--shell-panel-body-padding);\n}\n\n.page-panel--split {\n  height: 100%;\n}\n\n.page-panel--soft {\n  border-color: var(--panel-border-strong);\n  background: var(--panel-bg-solid);\n}\n\n.page-split-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 2.35fr) minmax(236px, 272px);\n  align-items: start;\n  gap: var(--shell-page-split-gap);\n  min-width: 0;\n  width: 100%;\n}\n\n.page-split-layout--single {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.page-split-layout--focus-main {\n  grid-template-columns: minmax(0, 2.8fr) minmax(220px, 248px);\n}\n\n.page-main-column,\n.page-side-column {\n  min-width: 0;\n}\n\n.page-main-column {\n  display: flex;\n  flex-direction: column;\n  gap: var(--shell-page-main-gap);\n  min-width: 0;\n  overflow: hidden;\n}\n\n.page-side-column {\n  display: flex;\n  flex-direction: column;\n  gap: var(--shell-page-side-gap);\n  position: sticky;\n  top: 0;\n  /* 侧栏高于视口时允许内部滚动，避免 sticky 钉住后底部内容不可达 */\n  max-height: 100vh;\n  overflow-y: auto;\n}\n\n/* 侧栏卡片不参与 flex 收缩，超出部分交给侧栏自身滚动，避免卡片内容被截断 */\n.page-side-column > * {\n  flex-shrink: 0;\n}\n\n.side-rail-panel .arco-card-body {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding: 18px 16px 16px;\n}\n\n.side-rail-panel .arco-card-head {\n  min-height: auto;\n  padding: 14px 16px 0;\n  border-bottom: none;\n  background: transparent;\n}\n\n.side-rail-panel .arco-card-header-title {\n  color: var(--text-primary);\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.4;\n}\n\n.side-rail-panel__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 14px;\n}\n\n.side-rail-panel__title {\n  display: block;\n  color: var(--text-primary);\n  font-weight: 600;\n  letter-spacing: 0.01em;\n  line-height: 1.4;\n}\n\n.side-rail-panel__extra {\n  flex-shrink: 0;\n}\n\n.side-rail-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.side-rail-item {\n  padding: 11px 12px;\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-md);\n  background: color-mix(in srgb, var(--panel-muted) 76%, var(--surface-lift));\n}\n\n.side-rail-item--warning {\n  border-color: color-mix(in srgb, var(--color-warning-bg) 58%, var(--panel-border));\n  background: color-mix(in srgb, var(--color-warning-bg) 20%, var(--surface-lift));\n}\n\n.side-rail-item--danger {\n  border-color: color-mix(in srgb, var(--color-error-bg) 62%, var(--panel-border));\n  background: color-mix(in srgb, var(--color-error-bg) 18%, var(--surface-lift));\n}\n\n.side-rail-item__label {\n  display: block;\n  color: var(--text-tertiary);\n  font-size: 12px;\n  margin-bottom: 7px;\n  line-height: 1.5;\n}\n\n.side-rail-item__value {\n  display: block;\n  color: var(--text-primary);\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1.35;\n}\n\n.side-rail-item__desc {\n  display: block;\n  margin-top: 6px;\n  color: var(--text-secondary);\n  font-size: 12px;\n  line-height: 1.6;\n}\n\n.side-rail-note {\n  padding: 13px 14px;\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-md);\n  background: color-mix(in srgb, var(--panel-muted) 72%, var(--surface-lift));\n}\n\n.side-rail-note--warning {\n  border-color: color-mix(in srgb, var(--color-warning-bg) 58%, var(--panel-border));\n  background: color-mix(in srgb, var(--color-warning-bg) 20%, var(--surface-lift));\n}\n\n.side-rail-note--danger {\n  border-color: color-mix(in srgb, var(--color-error-bg) 62%, var(--panel-border));\n  background: color-mix(in srgb, var(--color-error-bg) 18%, var(--surface-lift));\n}\n\n.side-rail-note__title {\n  display: block;\n  color: var(--text-primary);\n  font-weight: 600;\n  line-height: 1.5;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.side-rail-note__desc {\n  display: block;\n  margin-top: 4px;\n  color: var(--text-secondary);\n  font-size: 12px;\n  