ess);\n}\n\n.execution-step-rail__step--failed .execution-step-rail__marker,\n.execution-step-rail__step--canceled .execution-step-rail__marker {\n  border-color: var(--color-error);\n}\n\n@media (max-width: 768px) {\n  .operational-primitive__header,\n  .context-selector__layout,\n  .change-diff__row {\n    grid-template-columns: 1fr;\n  }\n\n  .operational-primitive__header {\n    display: grid;\n  }\n\n  .task-log-viewer__row,\n  .execution-step-rail__step {\n    grid-template-columns: 1fr;\n  }\n}\n"],["STYLE",{},".password-input__toggle {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0;\n  border: 0;\n  color: var(--text-tertiary);\n  font-size: 16px;\n  line-height: 1;\n  background: transparent;\n  cursor: pointer;\n}\n\n.password-input__toggle:hover {\n  color: var(--text-primary);\n}\n\n.password-input__toggle:focus-visible {\n  outline: 2px solid var(--brand-primary);\n  outline-offset: 2px;\n  border-radius: var(--radius-xs);\n}\n\n.password-input__toggle:disabled {\n  color: var(--text-tertiary);\n  cursor: not-allowed;\n  opacity: 0.5;\n}\n"],["STYLE",{},".auth-login-page {\n  position: relative;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  min-height: 100dvh;\n  overflow: hidden;\n  background: var(--app-bg);\n}\n\n.auth-login-page__brand-pane,\n.auth-login-page__form-pane {\n  z-index: 1;\n}\n\n.auth-login-page__brand-pane {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-3xl-plus) var(--space-3xl-alt);\n  border-right: 1px solid var(--panel-border);\n  background: var(--panel-bg-solid);\n}\n\n.auth-login-page__brand-inner {\n  width: min(100%, 500px);\n}\n\n.auth-login-page__brand {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: var(--space-3xl);\n}\n\n.auth-login-page__brand-mark {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid color-mix(in srgb, var(--brand-primary) 16%, var(--panel-border));\n  border-radius: var(--radius-sm);\n  color: var(--brand-primary);\n  font-size: 20px;\n  font-weight: 700;\n  background: color-mix(in srgb, var(--brand-primary) 8%, var(--surface-lift));\n  overflow: hidden;\n}\n\n.auth-login-page__brand-mark img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.auth-login-page__brand-copy {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.auth-login-page__mobile-brand {\n  display: none;\n}\n\n.auth-login-page__brand-title {\n  color: var(--text-primary);\n  font-size: 18px;\n  font-weight: 600;\n}\n\n.auth-login-page__brand-subtitle {\n  color: var(--text-tertiary);\n  font-size: 13px;\n}\n\n.auth-login-page__tag,\n.auth-login-card__tag {\n  width: fit-content;\n  border-radius: var(--radius-pill);\n}\n\n.auth-login-page .auth-login-page__headline {\n  max-width: 460px;\n  margin: var(--space-lg) 0 var(--space-md-plus);\n  color: var(--text-primary);\n  font-size: 32px;\n  line-height: 1.18;\n  letter-spacing: -0.02em;\n}\n\n.auth-login-page .auth-login-page__description {\n  max-width: 460px;\n  margin: 0;\n  color: var(--text-secondary);\n  line-height: 1.8;\n}\n\n.auth-login-page__features {\n  margin-top: var(--space-xl-alt);\n  row-gap: 10px;\n}\n\n.auth-login-page__features .arco-tag {\n  min-height: 30px;\n  border-radius: var(--radius-pill);\n  color: var(--text-secondary);\n  background: var(--panel-bg-solid);\n}\n\n.auth-login-page__footer {\n  margin-top: var(--space-xl-plus);\n  color: var(--text-tertiary);\n  font-size: 12px;\n}\n\n/* Deliberately static: the absolutely placed tool row then resolves against the\n   page (its true corner) instead of this pane, which is only the right half on\n   wide screens and the bottom band on narrow ones. */\n.auth-login-page__form-pane {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-lg);\n  /* Symmetric vertical padding: an asymmetric inset offsets the card from true\n     centre, which reads as \"sitting too high\" on tall displays. */\n  padding: var(--space-3xl-plus) var(--space-3xl-alt);\n}\n\n.auth-login-page__tools {\n  position: absolute;\n  z-index: 2;\n  top: var(--space-xl-plus);\n  right: var(--space-2xl);\n  display: flex;\n  flex-wrap: nowrap;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 10px;\n  max-width: calc(100% - var(--space-2xl) * 2);\n}\n\n/* Ghost treatment: the utility controls must not compete with the card for attention. */\n.auth-login-page__tools .auth-login-page__tool-btn {\n  height: 34px;\n  border: 1px solid transparent;\n  border-radius: var(--radius-action);\n  background: transparent;\n  color: var(--text-secondary);\n  box-shadow: none;\n}\n\n.auth-login-page__tools .auth-login-page__tool-btn:hover {\n  border-color: transparent;\n  background: var(--panel-muted);\n  color: var(--text-primary);\n}\n\n.auth-login-page__tools .arco-select.auth-login-page__tool-btn {\n  width: 132px;\n}\n\n.auth-login-page__tools .arco-select.auth-login-page__tool-btn .arco-select-view {\n  background: transparent;\n}\n\n.auth-login-card {\n  width: min(100%, 430px);\n  padding: var(--space-2xl-alt);\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-lg);\n  background: var(--panel-bg-solid);\n  box-shadow: var(--panel-shadow-soft);\n}\n\n.auth-login-card__header {\n  margin-bottom: var(--space-xl);\n}\n\n/* Arco Typography ships word-break: break-all, which splits latin words mid-syllable on narrow screens. */\n.auth-login-card .arco-typography {\n  word-break: normal;\n  overflow-wrap: break-word;\n}\n\n.auth-login-card__tag {\n  margin-bottom: var(--space-lg);\n}\n\n.auth-login-card .auth-login-card__title {\n  margin: 0 0 var(--space-sm-plus);\n  color: var(--text-primary);\n}\n\n.auth-login-card .auth-login-card__subtitle {\n  margin: 0;\n  color: var(--text-secondary);\n  line-height: 1.7;\n}\n\n.auth-login-card__notice {\n  margin-bottom: var(--space-lg-large);\n  border-radius: var(--radius-control);\n}\n\n.auth-login-mfa-setup {\n  display: grid;\n  gap: 8px;\n  margin-bottom: var(--space-lg-alt);\n  padding: var(--space-md-plus);\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-control);\n  background: var(--panel-muted);\n}\n\n.auth-login-mfa-qr {\n  display: grid;\n  justify-items: center;\n  gap: 10px;\n  padding: var(--space-md) var(--space-sm-plus) var(--space-md-plus);\n  border: 1px solid var(--panel-border);\n  border-radius: var(--radius-control);\n  background: var(--panel-bg-solid);\n}\n\n.auth-login-mfa-qr__image {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 188px;\n  height: 188px;\n  border: 1px solid color-mix(in srgb, var(--text-primary) 8%, var(--panel-border));\n  border-radius: var(--radius-sm);\n  background: var(--surface-lift);\n}\n\n.auth-login-mfa-qr__image svg {\n  display: block;\n}\n\n.auth-login-mfa-qr__hint {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  color: var(--text-secondary);\n  font-size: 12px;\n  line-height: 1.5;\n  text-align: center;\n}\n\n.auth-login-mfa-setup__label {\n  color: var(--text-secondary);\n  font-size: 12px;\n}\n\n.auth-login-mfa-setup__secret,\n.auth-login-mfa-setup__uri {\n  max-width: 100%;\n  color: var(--text-primary);\n  font-family: 'JetBrains Mono', 'Cascadia Code', monospace;\n  font-size: 12px;\n  line-height: 1.6;\n  overflow-wrap: anywhere;\n}\n\n.auth-login-mfa-setup__uri {\n  color: var(--text-tertiary);\n}\n\n.auth-login-card .arco-input-inner-wrapper,\n.auth-login-card .arco-input-password {\n  min-height: 40px;\n  border: 1px solid var(--panel-border-strong);\n  border-radius: var(--radius-control);\n  background: var(--control-bg);\n  box-shadow: none;\n}\n\n.auth-login-card .arco-input-inner-wrapper:hover,\n.auth-login-card .arco-input-password:hover {\n  border-color: var(--brand-primary);\n}\n\n.auth-login-card .arco-input-inner-wrapper.arco-input-focus,\n.auth-login-card .arco-input-inner-wrapper:focus-within,\n.auth-login-card .arco-input-password.arco-input-focus,\n.auth-login-card .arco-input-password:focus-within {\n  border-color: var(--brand-primary);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-primary) 12%, transparent);\n}\n\n.auth-login-card .arco-input-password .arco-input-group,\n.auth-login-card .arco-input-password .arco-input-inner-wrapper {\n  min-height: inherit;\n  border: 0;\n  border-radius: inherit;\n  background: transparent;\n  box-shadow: none;\n}\n\n.auth-login-card .arco-input-inner-wrapper .arco-input,\n.auth-login-card .arco-input-password .arco-input {\n  border: 0;\n  background: transparent;\n  box-shadow: none;\n  outline: 0;\n}\n\n.auth-login-card__submit {\n  height: 44px;\n  margin-top: var(--space-xs);\n  border-radius: var(--radius-action);\n  font-weight: 600;\n}\n\n@media (max-width: 1100px) {\n  .auth-login-page {\n    grid-template-columns: 1fr;\n  }\n\n  .auth-login-page__brand-pane {\n    padding: var(--space-3xl-alt) var(--space-2xl) var(--space-xl-plus);\n    border-right: none;\n    border-bottom: 1px solid var(--panel-border);\n  }\n\n  .auth-login-page__brand {\n    margin-bottom: var(--space-xl-plus);\n  }\n\n  .auth-login-page__form-pane {\n    padding: var(--space-3xl) var(--space-xl);\n  }\n}\n\n@media (max-width: 720px) {\n  .auth-login-page {\n    display: flex;\n    flex-direction: column;\n    overflow: auto;\n  }\n\n  .auth-login-page__brand-pane {\n    display: none;\n  }\n\n  .auth-login-page .auth-login-page__headline {\n    margin-top: var(--space-md);\n    font-size: 24px;\n  }\n\n  .auth-login-page__tools {\n    /* On phones the page scrolls, so the corner placement would pin the controls\n       over the brand block. Keep them in flow above the card instead. */\n    position: static;\n    max-width: 100%;\n    /* Long localized theme labels (j