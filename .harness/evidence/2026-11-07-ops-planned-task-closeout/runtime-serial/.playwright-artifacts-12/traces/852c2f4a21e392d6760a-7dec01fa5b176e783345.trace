;\n  --space-lg-large: 22px;\n  --space-xl: 24px;\n  --space-xl-alt: 26px;\n  --space-xl-plus: 28px;\n  --space-2xl: 32px;\n  --space-2xl-alt: 34px;\n  --space-2xl-plus: 36px;\n  --space-3xl: 48px;\n  --space-3xl-alt: 56px;\n  --space-3xl-plus: 64px;\n  --space-4xl: 84px;\n  --space-4xl-plus: 88px;\n  --font-size-caption: 12px;\n  --font-size-body-sm: 13px;\n  --font-size-body: 14px;\n  --font-size-body-lg: 16px;\n  --font-size-heading-sm: 18px;\n  --font-size-heading: 20px;\n  --font-size-display: 24px;\n  --line-height-tight: 1.3;\n  --line-height-base: 1.5;\n  --line-height-relaxed: 1.7;\n  --motion-duration-fast: 120ms;\n  --motion-duration-base: 200ms;\n  --motion-duration-slow: 320ms;\n  --motion-ease-standard: cubic-bezier(0.4, 0, 0.2, 1);\n  --motion-ease-emphasized: cubic-bezier(0.2, 0, 0, 1);\n  --z-base: 1;\n  --z-sticky: 100;\n  --z-dropdown: 1000;\n  --z-overlay: 1200;\n  --z-modal: 1300;\n  --z-notification: 1400;\n  /* 容器分类 - 交互容器（需要用户操作的元素） */\n  --container-interactive-bg: var(--panel-bg-solid);\n  --container-interactive-border: var(--panel-border);\n  --container-interactive-hover-bg: rgba(var(--primary-1), 0.5);\n  --container-interactive-focus-border: var(--brand-primary);\n  /* 容器分类 - 展示容器（信息展示、分组容器） */\n  --container-display-bg: var(--panel-muted);\n  --container-display-border: rgba(0, 0, 0, 0.06);\n  --container-display-separator: rgba(0, 0, 0, 0.04);\n  --container-display-elevated: var(--panel-bg-solid);\n}\n\n:root[data-pantheon-theme='emerald'] {\n  --app-bg: #f6faf8;\n  --brand-primary: #00a870;\n  --brand-primary-soft: rgba(0, 168, 112, 0.13);\n  --brand-primary-muted: rgba(0, 168, 112, 0.08);\n  --shell-sider-bg: #143126;\n  --shell-sider-elevated: #1a3d32;\n  --primary-1: 232, 255, 248;\n  --primary-2: 173, 245, 224;\n  --primary-3: 113, 232, 200;\n  --primary-4: 64, 214, 177;\n  --primary-5: 25, 191, 151;\n  --primary-6: 0, 168, 112;\n  --primary-7: 0, 135, 94;\n  --primary-8: 0, 102, 76;\n  --primary-9: 0, 71, 57;\n  --primary-10: 