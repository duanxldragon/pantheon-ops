+"""Deterministic offline R1 probes. The transport only records command strings.
+
+Replacement attacks change memory-backed reads, never original artifacts. Small
+temporary regular files supply real fd metadata; no credentials/native API/remote.
+"""
+from contextlib import ExitStack
+import hashlib
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import shlex
+from types import SimpleNamespace
+import sys
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+spec = importlib.util.spec_from_file_location('adoption_v2', Path(__file__).with_name('argo-adoption-v2-root-run.py'))
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+real_sha256 = hashlib.sha256
+
+
+def digest(raw):
+    return real_sha256(raw).hexdigest()
+
+
+class MemorySource(io.BytesIO):
+    def __init__(self, raw, backing):
+        super().__init__(raw)
+        self.backing = backing
+
+    def fileno(self):
+        return self.backing.fileno()
+
+    def close(self):
+        self.backing.close()
+        super().close()
+
+
+class Channel:
+    def __init__(self, raw=b'{"nativeUpdateAccepted": true}', err=b''):
+        self.raw, self.err = raw, err
+
+    def exit_status_ready(self):
+        return True
+
+    def recv_ready(self):
+        return bool(self.raw)
+
+    def recv_stderr_ready(self):
+        return bool(self.err)
+
+    def recv(self, size):
+        result, self.raw = self.raw[:size], self.raw[size:]
+        return result
+
+    def recv_stderr(self, size):
+        result, self.err = self.err[:size], self.err[size:]
+        return result
+
+    def recv_exit_status(self):
+        return 0
+
+
+class RootRunnerTests(unittest.TestCase):
