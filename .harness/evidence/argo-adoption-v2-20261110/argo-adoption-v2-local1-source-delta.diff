+    if receipt['exitCode'] == 0:
+        seal = {**original_seal, 'taskId': receipt['taskId'], 'originalArtifactSeal': original_path.relative_to(ROOT).as_posix(),
+                'originalArtifactSealSHA256': ORIGINAL_SHA, 'files': {**original_seal['files'], **new_after},
+                'v2VerificationReceipt': receipt_path.relative_to(ROOT).as_posix(),
+                'v2VerificationReceiptSHA256': sha(receipt_path), 'P0Approved': False}
+        write_json(seal_path, seal)
+        print(json.dumps({'artifact': seal_path.relative_to(ROOT).as_posix(), 'sealSHA256': sha(seal_path)}))
+    return receipt['exitCode']
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
