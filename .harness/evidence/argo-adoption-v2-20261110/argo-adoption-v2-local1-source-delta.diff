+"""Narrow local v2 verification/seal. Never imports private transport or deploys.
+
+Exclusive evidence writes preserve original receipts, failures and 31-file seal.
+Go/source-wide/race/runtime approval remains with root's independent lane.
+"""
+import argparse
+import ast
+import datetime
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[2]
+LOCAL = ROOT / '.local/ops-acceptance'
+ORIGINAL = ROOT / '.harness/evidence/argo-adoption-20261110'
+EVIDENCE = ROOT / '.harness/evidence/argo-adoption-v2-20261110'
+EV = ROOT / '.harness/evidence/2026-11-07-ops-planned-task-closeout/verification/p0-integration-20261109'
+ORIGINAL_SHA = '08ba8f44013b10f92c533a1f96ed55a7346b0f6e17a968b8c313fdf1ab4d79ec'
+NEW_NAMES = ['argo-adoption-v2-root-run.py', 'argo-adoption-v2-deploy-test.py', 'argo-adoption-v2-verify.py']
+
+
+def sha(path):
+    value = hashlib.sha256()
+    with path.open('rb') as source:
+        for chunk in iter(lambda: source.read(1 << 20), b''):
+            value.update(chunk)
+    return value.hexdigest()
+
+
+def write_json(path, value):
+    with path.open('x', encoding='utf-8') as output:
+        json.dump(value, output, indent=2)
+        output.write('\n')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--label', required=True)
+    args = parser.parse_args()
+    if not args.label.isalnum():
+        raise ValueError('fresh-alphanumeric-label-required')
+    EVIDENCE.mkdir(exist_ok=True)
+    receipt_path = EVIDENCE / ('argo-adoption-v2-' + args.label + '-verification.json')
+    seal_path = EVIDENCE / 'argo-adoption-v2-artifact-seal.json'
+    if receipt_path.exists() or seal_path.exists():
+        raise ValueError('fresh-evidence-required')
+    original_path = ORIGINAL / 'artifact-seal.json'
+    original_bytes = original_path.read_bytes()
+    if hashlib.sha256(original_bytes).hexdigest() != ORIGINAL_SHA:
+        raise ValueError('original-seal-drift')
+    original_seal = json.loads(original_bytes)
+    if len(original_seal['files']) != 31:
+        raise ValueError('original-inventory-drift')
+    expected = dict(original_seal['files'])
+    expected[original_seal['verificationReceipt']] = original_seal['verificationReceiptSHA256']
+    expected['.local/ops-acceptance/resume-argo-v6-reviewed-linux'] = original_seal['binarySHA256']
+    for relative, pin in expected.items():
+        if sha(ROOT / relative) != pin:
+            raise ValueError('preserved-source-drift')
+    if (LOCAL / 'resume-argo-v6-reviewed-linux').stat().st_size != original_seal['binarySize']:
+        raise ValueError('binary-size-drift')
+    preserved = set(ROOT / p for p in expected)
+    preserved.update(p for p in ORIGINAL.rglob('*') if p.is_file())
+    preserved.update(EV / name for name in [
+        'resume-argo-adoption-independent-code-report.md', 'resume-argo-adoption-independent-code-report.receipt.json',
+        'resume-argo-adoption-independent-arch-report.md', 'resume-argo-adoption-independent-arch-report.receipt.json'])
+    before = {p.relative_to(ROOT).as_posix(): sha(p) for p in sorted(preserved)}
+    sources = [LOCAL / name for name in NEW_NAMES]
+    new_before = {p.relative_to(ROOT).as_posix(): sha(p) for p in sources}
+    receipt = {'taskId': 'argo-adoption-v2-20261110', 'parentTask': original_seal['parentTask'],
+               'parentPacket': 'docs/harness/tasks/2026-11-07-ops-planned-task-closeout.task.md',
+               'deliveryTier': 'L2', 'role': 'Generator', 'scope': 'R1 local deployment runner only',
+               'startedAt': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+               'originalArtifactSealSHA256': ORIGINAL_SHA, 'preservedHashesBefore': before,
+               'newSourceHashesBefore': new_before, 'commands': [],
+               'remoteExecuted': False, 'credentialsRead': False, 'P0Approved': False,
+               'independentReviewRequired': True, 'fullRaceRerun': False, 'businessPackageRerun': False}
+    commands = [
+        ('offline', [sys.executable, '-B', str(LOCAL / NEW_NAMES[1])], 0),
+        ('originalHelperOffline', [sys.executable, '-B', str(LOCAL / 'argo-adoption-deploy-test.py')], 0),
+        ('syntaxCompile', [sys.executable, '-B', '-c',
+                          'import ast,pathlib,sys; '
+                          '[compile(ast.parse(pathlib.Path(p).read_bytes(),filename=p,feature_version=(3,9)),p,"exec") for p in sys.argv[1:]]; '
+                          'print("AST Python 3.9 + in-memory compile: PASS (no imports/pyc)")', *map(str, sources)], 0),
+        ('diffCheck', ['git', 'diff', '--check', '--no-index', '--', '.local/ops-acceptance/argo-adoption-root-run.py',
+                       '.local/ops-acceptance/argo-adoption-v2-root-run.py'], 0)]
+    # Sensitivity checks mutate only the loaded module's memory. The selected
+    # regressions must fail by assertion when either checked-buffer use regresses.
+    mutant_script = (
+        'import pathlib,sys; runner=pathlib.Path(sys.argv.pop(1)); test=pathlib.Path(sys.argv.pop(1)); '
+        'old=sys.argv.pop(1); new=sys.argv.pop(1); source=runner.read_text(); assert old in source; '
+        'replacement="exec(compile("+repr(source.replace(old,new))+", "+repr(str(runner))+", \'exec\'), module.__dict__)"; '
+        'tests=test.read_text().replace("spec.loader.exec_module(module)",replacement); '
+        'exec(compile(tests,str(test),"exec"),{"__file__":str(test),"__name__":"__main__"})')
+    for name, old, new, case in [
+        ('helperRereadMutant', "helper = helper_bytes.decode('utf-8')", "helper = HELPER.read_text(encoding='utf-8')",
+         'test_helper_replaced_after_digest_uses_only_captured_approved_bytes'),
+        ('sealRereadMutant', 'json.loads(seal_bytes, object_pairs_hook=unique_object)',
+         'json.loads(SEAL.read_bytes(), object_pairs_hook=unique_object)',
+         'test_seal_path_replaced_after_capture_parses_original_buffer')]:
+        commands.append((name, [sys.executable, '-B', '-c', mutant_script, str(sources[0]), str(sources[1]),
+                                old, new, 'RootRunnerTests.' + case], 1))
+    exit_code = 0
+    for name, command, expected_code in commands:
+        start = time.monotonic()
+        completed = subprocess.run(command, cwd=ROOT, capture_output=True, timeout=60)
+        raw = completed.stdout + completed.stderr
+        log = EVIDENCE / ('argo-adoption-v2-' + args.label + '-' + name + '.log')
+        with log.open('xb') as output:
+            output.write(raw)
+        passed = completed.returncode == expected_code
+        if expected_code == 1:
+            passed = passed and b'AssertionError' in raw and b'FAILED (failures=1)' in raw
+        row = {'name': name, 'command': command, 'cwd': '.', 'exitCode': completed.returncode,
+               'expectedExitCode': expected_code, 'passed': passed,
+               'elapsedSeconds': round(time.monotonic() - start, 3),
+               'log': log.relative_to(ROOT).as_posix(), 'logSHA256': sha(log)}
+        receipt['commands'].append(row)
+        exit_code = exit_code or (0 if passed else 1)
+        print(json.dumps({key: value for key, value in row.items() if key != 'command'}), flush=True)
+    delta = EVIDENCE / ('argo-adoption-v2-' + args.label + '-source-delta.diff')
+    with delta.open('x', encoding='utf-8', newline='\n') as output:
+        for path in sources:
+            previous = LOCAL / 'argo-adoption-root-run.py' if path.name == NEW_NAMES[0] else None
+            old_lines = previous.read_text().splitlines(keepends=True) if previous else []
+            output.writelines(difflib.unified_diff(old_lines, path.read_text().splitlines(keepends=True),
+                                                   fromfile=previous.relative_to(ROOT).as_posix() if previous else '/dev/null',
+                                                   tofile=path.relative_to(ROOT).as_posix()))
+            if any(line.rstrip() != line for line in path.read_text().splitlines()):
