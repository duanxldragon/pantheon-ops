  "principles": [
    {
      "id": "efficiency",
      "rule": "Prefer defaults, selection and shorter repeatable workflows over manual re-entry."
    },
    {
      "id": "clarity",
      "rule": "Use precise copy, visible state, explicit feedback and one dominant task per page region."
    },
    {
      "id": "consistency",
      "rule": "Reuse Pantheon components, tokens, terminology and interaction semantics."
    },
    {
      "id": "recoverability",
      "rule": "Keep failure, stale state and recovery actions visible without discarding valid context."
    }
  ],
  "requiredMatrix": {
    "viewports": ["1440x900", "390x844"],
    "themes": ["light", "dark"],
    "baselineStates": ["loading", "empty", "error", "forbidden"],
    "operationalStates": ["stale", "partial-failure"],
    "accessibility": [
      "keyboard-path",
      "visible-focus",
      "screen-reader-name",
      "zoom-200",
      "reduced-motion",
      "non-color-status"
    ],
    "contentStress": ["long-zh-CN", "long-en-US"]
  },
  "interactionContracts": {
    "actions": {
      "onePrimaryPerActionArea": true,
      "loadingPreventsDuplicateAction": true
    },
    "forms": {
      "immediateValidation": true,
      "errorRecoveryPreservesInput": true,
      "complexFlowsMayBeSplit": true
    },
    "tables": {
      "preferredVisibleColumnRange": [5, 9],
      "lowFrequencyColumnsConfigurable": true,
      "stableWidths": true,
      "intentionalHorizontalScroll": true
    },
    "loading": {
      "scopes": ["page", "component", "action"],
      "preserveContextWhenPossible": true
    }
  },
  "copyContract": {
    "terminology": ["consistent-nouns", "consistent-verbs", "concise", "accurate", "professional-friendly"],
    "destructiveAction": ["object", "count-or-scope", "consequence", "recoverability", "recovery-action"]
  },
  "taskAdmission": {
    "effectiveTaskDate": "2026-08-31",
    "qualityProfiles": ["ui-runtime", "frontend-ui-l2"],
