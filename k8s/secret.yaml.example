apiVersion: v1
kind: Secret
metadata:
  name: pantheon-secret
  namespace: pantheon
  labels:
    app: pantheon-base
type: Opaque
stringData:
  # Database connection string
  # Format: user:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
  PANTHEON_DSN: "pantheon_user:CHANGE_ME_PASSWORD@tcp(mysql-host.example.com:3306)/pantheon?charset=utf8mb4&parseTime=True&loc=Local"

  # Redis configuration
  PANTHEON_REDIS_ADDR: "redis-host.example.com:6379"
  PANTHEON_REDIS_PASSWORD: "CHANGE_ME_REDIS_PASSWORD"

  # Metrics authentication token
  PANTHEON_METRICS_BEARER_TOKEN: "CHANGE_ME_METRICS_TOKEN"

  # Optional: CORS allowed origins (comma-separated)
  # PANTHEON_ALLOWED_ORIGINS: "https://app.example.com,https://admin.example.com"
